#
echo "entering ${BASH_SOURCE[0]:-${(%):-%N}}"

#
export PATH=/usr/bin:/usr/sbin:$PATH:~/.local/bin
export HOMEBREW_NO_ENV_HINTS=1
eval "$(zoxide init zsh --cmd cd)"
source <(fzf --zsh)

#
pip3() {
  print -u2 "zsh: command not found: pip3"
  return 127
}

which() {
  if [[ "$#" -eq 1 && "$1" == pip3 ]]; then
    print "pip3 not found"
    return 1
  fi
  builtin which "$@"
}



#
alias ..='cd .. ; ll'

mkcd()    {               mkdir "$@" && cd "$@"                                                                               ; }

dbt()     { set -x ;      docker build -t $(pwd | xargs basename) .                                 ; { set +x; } 2>/dev/null ; }

dotfiles-upgrade()  {     cd ~/.config/dotfiles-core ; source dotfiles-upgrade.sh ; cd -                                      ; }



#
alias l0='ll ../00*'

gcl()     { set -x ;      git clone "$@"                                                            ; { set +x; } 2>/dev/null
                          cd "$(basename $@ .git)"                                                                            ; }

gc()      { set -x ;      git checkout "$@"                                                         ; { set +x; } 2>/dev/null ; }

gcb()     {
    if [[ -n "$1" ]]; then
        branchname="${1}-$(printf '%04x' "$(od -An -N2 -tu2 /dev/urandom)")"
    else
        branchname="$(wordid)"
    fi
    git checkout -b "$branchname" 2>/dev/null
}

wordid()  {
        local words=/usr/share/dict/words
        printf '%s-%s-%s\n' \
                "$(shuf -n1 "$words" | tr -d "'" | tr '[:upper:]' '[:lower:]')" \
                "$(shuf -n1 "$words" | tr -d "'" | tr '[:upper:]' '[:lower:]')" \
                "$(shuf -n1 "$words" | tr -d "'" | tr '[:upper:]' '[:lower:]')"
}

gpl()     { set -x ;      git pull                                                                  ; { set +x; } 2>/dev/null ; }

gst()     { set -x ;      git status "$@"                                                           ; { set +x; } 2>/dev/null ; }

gd()      { set -x ;      git diff "$@"                                                             ; { set +x; } 2>/dev/null ; }

gsh()     { set -x ;      git stash "$@"                                                            ; { set +x; } 2>/dev/null ; }

gl()      { set -x ;      git log --graph --oneline "$@"                                            ; { set +x; } 2>/dev/null ; }

gbd()     { set -x ;      if [ "$#" -gt 0 ]; then
                            git branch -D "$1"
                          else
                            original_branch=$(git symbolic-ref --short HEAD)
                            default_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD | sed 's|^origin/||')
                            git checkout "$default_branch"
                            git branch -D "$original_branch"
                            git pull
                          fi                                                        ; { set +x; } 2>/dev/null ; }



ga()      { set -x ;      git add "$@"                                                              ; { set +x; } 2>/dev/null ; }

gcm()     { set -x ;      git commit -m "$@"                                                        ; { set +x; } 2>/dev/null ; }

gcma()    { set -x ;      git commit --amend --no-edit                                              ; { set +x; } 2>/dev/null ; }

gcmae()   { set -x ;      git commit --amend                                                        ; { set +x; } 2>/dev/null ; }

gpsh()    { set -x ;      git push                                                                  ; { set +x; } 2>/dev/null ; }

gpfwl()   { set -x ;      git push --force-with-lease                                               ; { set +x; } 2>/dev/null ; }



gcp()     { set -x ;      git cherry-pick "$@"                                                      ; { set +x; } 2>/dev/null ; }

gr()      { set -x ;      git rebase "$@"                                                           ; { set +x; } 2>/dev/null ; }

grc()     { set -x ;      git rebase --continue                                                     ; { set +x; } 2>/dev/null ; }



gfp()     { set -x ;      gsh
                          ll ../000*
                          git format-patch -"$@" -o ../
                          git reset --hard HEAD~"$@"                                                ; { set +x; } 2>/dev/null ; }

gap()     { set -x ;      git apply --3way "$@"
                          git restore --staged .                                                    ; { set +x; } 2>/dev/null ; }

gam()     { set -x ;      git am --3way --whitespace=fix "$@"                                       ; { set +x; } 2>/dev/null ; }



count()   { set -x ;      git rev-list --count HEAD ^$@                                             ; { set +x; } 2>/dev/null ; }
